# Continue a GPU LAMMPS-MACE MD run from a restart file.
# Required command-line variables:
#   -var restart_file <LAMMPS restart>
#   -var mace_model <MACE *-lammps.pt model>
#   -var run_label <label for logs/trajectory/restarts>
#   -var nsteps <additional number of MD steps>
#   -var dump_every <trajectory dump interval>
#   -var restart_every <restart interval>

shell mkdir -p trajectories logs restarts data/lammps
log logs/${run_label}.lammps.log

variable temperature equal 400.0
variable dt equal 0.001
variable tdamp equal 0.100

units metal
dimension 3
boundary p p p
atom_style atomic
atom_modify map yes
newton on

read_restart ${restart_file}

pair_style mace no_domain_decomposition
pair_coeff * * ${mace_model} C Li Si

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

timestep ${dt}

fix ensemble all nvt temp ${temperature} ${temperature} ${tdamp}

thermo 1000
thermo_style custom step time temp pe ke etotal press vol
thermo_modify flush yes

dump traj all custom ${dump_every} trajectories/${run_label}.lammpstrj id type element x y z vx vy vz
dump_modify traj sort id element C Li Si

restart ${restart_every} restarts/${run_label}.*.restart

run ${nsteps}

write_restart restarts/${run_label}.final.restart
write_data data/lammps/${run_label}.final.data

unfix ensemble
undump traj
